@inherits LayoutComponentBase
@inject AuthState AuthState
@inject ApiClient Api
@inject NavigationManager Nav

<div class="app-shell">
    <aside class="sidebar">
        <div class="brand">
            <svg class="brand-mark" viewBox="0 0 24 24" width="20" height="20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M12 1.5 L21.9 7.25 V18.75 L12 24.5 L2.1 18.75 V7.25 Z" stroke="currentColor" stroke-width="1.8"/>
            <path d="M12 1.5 V24.5 M2.1 7.25 L21.9 18.75 M21.9 7.25 L2.1 18.75" stroke="currentColor" stroke-width="1" opacity="0.5"/>
        </svg>
            <span class="brand-name">Hextech Software</span>
        </div>

        <NavMenu />

        <div class="sidebar-footer">
            <div class="user-chip">
                <span class="user-email">@AuthState.Email</span>
                <span class="user-role">@AuthState.Role</span>
            </div>
            <NavLink href="/change-password" class="btn-link btn-link-muted">Cambiar contraseña 🔑</NavLink>
            <button class="btn-link btn-link-muted" @onclick="Logout">Cerrar sesión</button>
        </div>
    </aside>

    <main class="content">
        @Body
    </main>
</div>

@code {
    private async Task Logout()
    {
        await Api.LogoutAsync();
        Nav.NavigateTo("/login", forceLoad: false);
    }
}
