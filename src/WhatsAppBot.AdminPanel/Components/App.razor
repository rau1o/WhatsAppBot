<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <title>WhatsAppBot — Panel</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@500&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="css/app.css" />
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
          integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
    <HeadOutlet />
</head>
<body>
    <!-- prerender: false a propósito — con el prerender activado, Blazor
         renderiza la página primero SIN interop de JS (para SEO/velocidad
         percibida), y en ese primer render [Authorize] ve un AuthState
         vacío (todavía no hay forma de leer el refresh token guardado en
         el browser) y puede redirigir al login antes de que la
         restauración de sesión (ver Routes.razor) tenga chance de correr.
         Sin prerender, el circuito arranca directo interactivo, un único
         render, sin esa carrera. -->
    <Routes @rendermode="new InteractiveServerRenderMode(prerender: false)" />
    <script src="_framework/blazor.web.js"></script>
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
            integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
    <script src="js/locationPicker.js"></script>
    <script src="js/fileDownload.js"></script>
</body>
</html>
