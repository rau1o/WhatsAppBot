@page "/forgot-password"
@layout AuthLayout
@inject ApiClient Api

<div class="auth-card">
    <div class="auth-brand">
        <svg class="brand-mark" viewBox="0 0 24 24" width="20" height="20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M12 1.5 L21.9 7.25 V18.75 L12 24.5 L2.1 18.75 V7.25 Z" stroke="currentColor" stroke-width="1.8"/>
            <path d="M12 1.5 V24.5 M2.1 7.25 L21.9 18.75 M21.9 7.25 L2.1 18.75" stroke="currentColor" stroke-width="1" opacity="0.5"/>
        </svg>
        <span class="brand-name">Hextech Software</span>
    </div>
    <h1>Restablecer contraseña</h1>
    <p class="auth-subtitle">Escribí tu email y te mandamos un link para elegir una contraseña nueva.</p>

    @if (_sent)
    {
        <p class="form-success">
            Si ese email está registrado, te va a llegar un correo en los próximos minutos con el link para
            restablecer tu contraseña. Revisá también la carpeta de spam.
        </p>
    }
    else
    {
        <form @onsubmit="HandleSubmit" @onsubmit:preventDefault="true">
            <div class="field">
                <label for="email">Email</label>
                <input id="email" type="email" autocomplete="username"
                       @bind="_email" @bind:event="oninput" required />
            </div>

            @if (_error is not null)
            {
                <p class="form-error">@_error</p>
            }

            <button type="submit" class="btn btn-primary btn-block" disabled="@_loading">
                @(_loading ? "Enviando..." : "Mandar link de reseteo")
            </button>
        </form>
    }

    <p class="auth-secondary-link">
        <a href="/login">Volver a iniciar sesión</a>
    </p>
</div>

@code {
    private string _email = "";
    private string? _error;
    private bool _loading;
    private bool _sent;

    private async Task HandleSubmit()
    {
        _loading = true;
        _error = null;
        StateHasChanged();

        var (success, error) = await Api.ForgotPasswordAsync(_email);

        _loading = false;

        if (!success)
        {
            _error = error;
            return;
        }

        _sent = true;
    }
}
