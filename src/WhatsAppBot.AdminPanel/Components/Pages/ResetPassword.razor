@page "/reset-password"
@layout AuthLayout
@inject ApiClient Api
@inject NavigationManager Nav

<div class="auth-card">
    <div class="auth-brand">
        <svg class="brand-mark" viewBox="0 0 24 24" width="20" height="20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M12 1.5 L21.9 7.25 V18.75 L12 24.5 L2.1 18.75 V7.25 Z" stroke="currentColor" stroke-width="1.8"/>
            <path d="M12 1.5 V24.5 M2.1 7.25 L21.9 18.75 M21.9 7.25 L2.1 18.75" stroke="currentColor" stroke-width="1" opacity="0.5"/>
        </svg>
        <span class="brand-name">Hextech Software</span>
    </div>
    <h1>Elegí tu contraseña nueva</h1>

    @if (string.IsNullOrWhiteSpace(Email) || string.IsNullOrWhiteSpace(Token))
    {
        <p class="form-error">
            Este link no es válido. Pedí uno nuevo desde <a href="/forgot-password">acá</a>.
        </p>
    }
    else if (_done)
    {
        <p class="form-success">Listo, tu contraseña quedó actualizada. Ya podés iniciar sesión con la nueva.</p>
        <p class="auth-secondary-link"><a href="/login">Ir a iniciar sesión</a></p>
    }
    else
    {
        <form @onsubmit="HandleSubmit" @onsubmit:preventDefault="true">
            <div class="field">
                <label for="newPassword">Contraseña nueva</label>
                <input id="newPassword" type="password" autocomplete="new-password"
                       @bind="_newPassword" @bind:event="oninput" required minlength="8" />
            </div>
            <div class="field">
                <label for="confirmPassword">Confirmar contraseña</label>
                <input id="confirmPassword" type="password" autocomplete="new-password"
                       @bind="_confirmPassword" @bind:event="oninput" required minlength="8" />
            </div>

            @if (_error is not null)
            {
                <p class="form-error">@_error</p>
            }

            <button type="submit" class="btn btn-primary btn-block" disabled="@_loading">
                @(_loading ? "Guardando..." : "Guardar contraseña nueva")
            </button>
        </form>
    }
</div>

@code {
    [SupplyParameterFromQuery]
    public string? Email { get; set; }

    [SupplyParameterFromQuery]
    public string? Token { get; set; }

    private string _newPassword = "";
    private string _confirmPassword = "";
    private string? _error;
    private bool _loading;
    private bool _done;

    private async Task HandleSubmit()
    {
        _error = null;

        if (_newPassword != _confirmPassword)
        {
            _error = "Las dos contraseñas no coinciden.";
            return;
        }

        _loading = true;
        StateHasChanged();

        var (success, error) = await Api.ResetPasswordAsync(Email!, Token!, _newPassword);

        _loading = false;

        if (!success)
        {
            _error = error;
            return;
        }

        _done = true;
    }
}
