@page "/login"
@layout AuthLayout
@inject ApiClient Api
@inject AuthState AuthState
@inject SessionPersistence SessionPersistence
@inject NavigationManager Nav

@if (_restoring)
{
    <div class="auth-card">
        <p class="muted">Verificando sesión...</p>
    </div>
}
else
{
<div class="auth-card">
    <div class="auth-brand">
        <span class="brand-mark">◆</span>
        <span class="brand-name">WhatsAppBot</span>
    </div>
    <h1>Ingresar</h1>
    <p class="auth-subtitle">Panel de administración de tu tienda</p>

    <form @onsubmit="HandleLogin" @onsubmit:preventDefault="true">
        <div class="field">
            <label for="email">Email</label>
            <input id="email" type="email" autocomplete="username"
                   @bind="_email" @bind:event="oninput" required />
        </div>
        <div class="field">
            <label for="password">Contraseña</label>
            <div class="password-field">
                <input id="password" type="@(_showPassword ? "text" : "password")" autocomplete="current-password"
                       @bind="_password" @bind:event="oninput" required />
                <button type="button" class="password-toggle" @onclick="TogglePasswordVisibility"
                        title="@(_showPassword ? "Ocultar contraseña" : "Mostrar contraseña")">
                    @(_showPassword ? "🙈" : "👁")
                </button>
            </div>
        </div>

        @if (_error is not null)
        {
            <p class="form-error">@_error</p>
        }

        <button type="submit" class="btn btn-primary btn-block" disabled="@_loading">
            @(_loading ? "Ingresando..." : "Ingresar")
        </button>
    </form>

    <p class="auth-secondary-link">
        <a href="/forgot-password">¿Olvidaste tu contraseña?</a>
    </p>
</div>
}

@code {
    // No usamos [SupplyParameterFromQuery] para ReturnUrl porque el
    // decoy Cookie scheme lo arma como una URL codificada (ej.
    // "%2Fproducts") — la leemos directo del query string de NavigationManager.
    private bool _restoring = true;
    private string _email = "";
    private string _password = "";
    private string? _error;
    private bool _loading;
    private bool _showPassword;

    private void TogglePasswordVisibility() => _showPassword = !_showPassword;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        var savedRefreshToken = await SessionPersistence.LoadRefreshTokenAsync();
        if (!string.IsNullOrWhiteSpace(savedRefreshToken))
        {
            var restored = await Api.RestoreSessionAsync(savedRefreshToken);
            if (restored)
            {
                Nav.NavigateTo(GetReturnUrl(), forceLoad: false);
                return; // seguimos navegando afuera — no hace falta sacar _restoring
            }
        }

        _restoring = false;
        StateHasChanged();
    }

    private string GetReturnUrl()
    {
        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        if (string.IsNullOrEmpty(uri.Query)) return "/products";

        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query);
        return query.TryGetValue("ReturnUrl", out var returnUrl) && !string.IsNullOrWhiteSpace(returnUrl)
            ? returnUrl.ToString()
            : "/products";
    }

    private async Task HandleLogin()
    {
        _loading = true;
        _error = null;
        StateHasChanged();

        var (success, error) = await Api.LoginAsync(_email, _password);

        _loading = false;

        if (!success)
        {
            _error = error;
            return;
        }

        Nav.NavigateTo(GetReturnUrl(), forceLoad: false);
    }
}
