@page "/change-password"
@attribute [Authorize]
@inject ApiClient Api

<div class="page-header">
    <div>
        <h1>Cambiar contraseña</h1>
        <p class="page-subtitle">Sobre todo si todavía estás usando la contraseña temporal que te dieron.</p>
    </div>
</div>

<div class="card form-card">
    <div class="field">
        <label for="current">Contraseña actual</label>
        <div class="password-field">
            <input id="current" type="@(_showPasswords ? "text" : "password")"
                   @bind="_currentPassword" @bind:event="oninput" autocomplete="current-password" />
        </div>
    </div>

    <div class="field">
        <label for="new">Contraseña nueva</label>
        <div class="password-field">
            <input id="new" type="@(_showPasswords ? "text" : "password")"
                   @bind="_newPassword" @bind:event="oninput" autocomplete="new-password" />
        </div>
    </div>

    <div class="field">
        <label for="confirm">Repetir contraseña nueva</label>
        <div class="password-field">
            <input id="confirm" type="@(_showPasswords ? "text" : "password")"
                   @bind="_confirmPassword" @bind:event="oninput" autocomplete="new-password" />
            <button type="button" class="password-toggle" @onclick="TogglePasswords"
                    title="@(_showPasswords ? "Ocultar contraseñas" : "Mostrar contraseñas")">
                @(_showPasswords ? "🙈" : "👁")
            </button>
        </div>
        <span class="field-hint">Mínimo 8 caracteres, con mayúscula, minúscula, número y símbolo.</span>
    </div>

    @if (_error is not null)
    {
        <p class="form-error">@_error</p>
    }
    @if (_success)
    {
        <p class="form-success">Listo, tu contraseña se actualizó ✅</p>
    }

    <div class="form-actions">
        <button class="btn btn-primary" @onclick="Submit" disabled="@_saving">
            @(_saving ? "Guardando..." : "Guardar")
        </button>
    </div>
</div>

@code {
    private string _currentPassword = "";
    private string _newPassword = "";
    private string _confirmPassword = "";
    private bool _showPasswords;
    private bool _saving;
    private string? _error;
    private bool _success;

    private void TogglePasswords() => _showPasswords = !_showPasswords;

    private async Task Submit()
    {
        _error = null;
        _success = false;

        if (string.IsNullOrWhiteSpace(_currentPassword) || string.IsNullOrWhiteSpace(_newPassword))
        {
            _error = "Completá los dos campos de contraseña.";
            return;
        }

        if (_newPassword != _confirmPassword)
        {
            _error = "La contraseña nueva no coincide con la repetición.";
            return;
        }

        if (_newPassword.Length < 8)
        {
            _error = "La contraseña nueva tiene que tener al menos 8 caracteres.";
            return;
        }

        _saving = true;
        var (success, error) = await Api.ChangePasswordAsync(_currentPassword, _newPassword);
        _saving = false;

        if (!success)
        {
            _error = error;
            return;
        }

        _success = true;
        _currentPassword = "";
        _newPassword = "";
        _confirmPassword = "";
    }
}
