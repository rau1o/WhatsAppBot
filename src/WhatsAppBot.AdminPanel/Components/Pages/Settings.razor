@page "/settings"
@attribute [Authorize(Roles = "Owner")]
@implements IAsyncDisposable
@inject ApiClient Api
@inject IConfiguration Configuration
@inject IJSRuntime JS
@inject GeocodingService Geocoding

@using Microsoft.AspNetCore.Components.Forms

<div class="page-header">
    <div>
        <h1>Configuración</h1>
        <p class="page-subtitle">Lo que tus clientes ven apenas te escriben por WhatsApp.</p>
    </div>
</div>

@if (_error is not null)
{
    <div class="alert alert-error">@_error</div>
}

@if (_loading)
{
    <p class="muted">Cargando configuración...</p>
}
else if (_settings is not null)
{
    <div class="card form-card">
        <h2>Datos de la tienda</h2>

        <div class="field">
            <label>Número de WhatsApp conectado</label>
            <input value="@_settings.WhatsAppPhoneNumberId" disabled />
            <span class="field-hint">Para cambiar el número hace falta reconectar la integración con Meta — no se edita acá.</span>
        </div>

        <div class="field">
            <label for="name">Nombre de la tienda</label>
            <input id="name" @bind="_name" @bind:event="oninput" />
        </div>

        <div class="field">
            <label for="locationName">Nombre del local (para el mensaje de ubicación)</label>
            <input id="locationName" @bind="_locationName" @bind:event="oninput" />
        </div>

        <div class="field">
            <label for="locationAddress">Dirección</label>
            <input id="locationAddress" @bind="_locationAddress" @bind:event="oninput" />
        </div>

        <div class="field">
            <label for="addressSearch">Buscar dirección</label>
            <div class="address-search">
                <input id="addressSearch" @bind="_addressQuery" @bind:event="oninput"
                       @onkeydown="OnSearchKeyDown" placeholder="Ej: Av. San Martín 456, Santa Cruz de la Sierra" />
                <button type="button" class="btn btn-ghost" @onclick="SearchAddress" disabled="@_searching">
                    @(_searching ? "Buscando..." : "Buscar")
                </button>
            </div>

            @if (_searchResults.Count > 0)
            {
                <ul class="address-results">
                    @foreach (var result in _searchResults)
                    {
                        <li>
                            <button type="button" class="btn-link" @onclick="() => SelectSearchResult(result)">
                                @result.DisplayName
                            </button>
                        </li>
                    }
                </ul>
            }
        </div>

        <div class="field">
            <label>Ubicación en el mapa</label>
            <span class="field-hint">Hacé click en el mapa, o arrastrá el marcador, para ajustar la posición exacta.</span>
            <div id="location-map" class="location-map"></div>
        </div>

        <div class="field-row">
            <div class="field">
                <label for="lat">Latitud</label>
                <input id="lat" type="number" step="0.000001" value="@_locationLatitude.ToString(System.Globalization.CultureInfo.InvariantCulture)" disabled />
            </div>
            <div class="field">
                <label for="lng">Longitud</label>
                <input id="lng" type="number" step="0.000001" value="@_locationLongitude.ToString(System.Globalization.CultureInfo.InvariantCulture)" disabled />
            </div>
        </div>

        @if (_saveError is not null)
        {
            <p class="form-error">@_saveError</p>
        }

        <div class="form-actions">
            <button class="btn btn-primary" @onclick="SaveGeneral" disabled="@_saving">
                @(_saving ? "Guardando..." : "Guardar cambios")
            </button>
        </div>
    </div>

    <div class="card form-card">
        <h2>Foto de fachada</h2>
        <p class="muted">Se la mandamos automáticamente a cada cliente nuevo, junto con la ubicación.</p>

        @if (!string.IsNullOrEmpty(_settings.FacadePhotoUrl))
        {
            <img class="settings-preview" src="@ResolveImageUrl(_settings.FacadePhotoUrl)" alt="Fachada de la tienda" />
        }

        <InputFile OnChange='@(e => UploadImage(e, "facade-photo"))' accept="image/png,image/jpeg,image/webp" />
        <span class="field-hint">JPG, PNG o WEBP, hasta 5 MB.</span>
    </div>

    <div class="card form-card">
        <h2>QR de pago</h2>
        <p class="muted">Se lo mandamos al cliente antes de pedirle el comprobante, cuando confirma su pedido.</p>

        @if (!string.IsNullOrEmpty(_settings.PaymentQrImageUrl))
        {
            <img class="settings-preview" src="@ResolveImageUrl(_settings.PaymentQrImageUrl)" alt="QR de pago" />
        }
        else
        {
            <p class="muted">Todavía no cargaste un QR — el bot va a saltar este paso hasta que subas uno.</p>
        }

        <InputFile OnChange='@(e => UploadImage(e, "payment-qr"))' accept="image/png,image/jpeg,image/webp" />
        <span class="field-hint">JPG, PNG o WEBP, hasta 5 MB.</span>
    </div>

    @if (_uploadError is not null)
    {
        <div class="alert alert-error">@_uploadError</div>
    }
}

@code {
    private const long MaxUploadSizeBytes = 5 * 1024 * 1024;

    private TenantSettingsDto? _settings;
    private bool _loading = true;
    private bool _saving;
    private string? _error;
    private string? _saveError;
    private string? _uploadError;

    private string _name = "";
    private string _locationName = "";
    private string _locationAddress = "";
    private double _locationLatitude;
    private double _locationLongitude;

    private string _addressQuery = "";
    private bool _searching;
    private List<GeocodeResult> _searchResults = [];

    private bool _mapInitialized;
    private DotNetObjectReference<Settings>? _dotNetRef;

    protected override async Task OnInitializedAsync() => await LoadSettings();

    private async Task LoadSettings()
    {
        _loading = true;
        _error = null;
        try
        {
            _settings = await Api.GetTenantSettingsAsync();
            if (_settings is null)
            {
                _error = "No pudimos cargar la configuración.";
                return;
            }

            _name = _settings.Name;
            _locationName = _settings.LocationName;
            _locationAddress = _settings.LocationAddress;
            _locationLatitude = _settings.LocationLatitude;
            _locationLongitude = _settings.LocationLongitude;
        }
        catch (Exception)
        {
            _error = "No pudimos cargar la configuración. Probá de nuevo en unos segundos.";
        }
        _loading = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_mapInitialized || _settings is null) return;

        _mapInitialized = true;
        _dotNetRef = DotNetObjectReference.Create(this);

        await JS.InvokeVoidAsync("locationPicker.init", "location-map", _locationLatitude, _locationLongitude, _dotNetRef);
    }

    // Invocado desde locationPicker.js cuando el usuario hace click en el
    // mapa o arrastra el marcador — así el mapa "empuja" el cambio hacia acá,
    // en vez de que Blazor tenga que hacer polling del estado de Leaflet.
    [JSInvokable]
    public void OnLocationPicked(double lat, double lng)
    {
        _locationLatitude = lat;
        _locationLongitude = lng;
        StateHasChanged();
    }

    private async Task OnSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await SearchAddress();
    }

    private async Task SearchAddress()
    {
        if (string.IsNullOrWhiteSpace(_addressQuery)) return;

        _searching = true;
        _searchResults = await Geocoding.SearchAsync(_addressQuery);
        _searching = false;

        if (_searchResults.Count == 0)
        {
            _saveError = "No encontramos ninguna dirección con ese texto — probá con más detalle (ciudad, calle y número).";
        }
    }

    private async Task SelectSearchResult(GeocodeResult result)
    {
        _locationLatitude = result.Latitude;
        _locationLongitude = result.Longitude;
        _searchResults = [];
        _addressQuery = result.DisplayName;
        _saveError = null;

        await JS.InvokeVoidAsync("locationPicker.setPosition", "location-map", result.Latitude, result.Longitude);
    }

    public async ValueTask DisposeAsync()
    {
        if (_mapInitialized)
        {
            try { await JS.InvokeVoidAsync("locationPicker.dispose", "location-map"); }
            catch (JSDisconnectedException) { /* el circuito ya se cerró, no hay nada que limpiar */ }
        }

        _dotNetRef?.Dispose();
    }

    private async Task SaveGeneral()
    {
        _saveError = null;

        if (string.IsNullOrWhiteSpace(_name) || string.IsNullOrWhiteSpace(_locationName) || string.IsNullOrWhiteSpace(_locationAddress))
        {
            _saveError = "Completá el nombre, el nombre del local y la dirección.";
            return;
        }

        _saving = true;

        var request = new UpdateTenantSettingsRequest(_name.Trim(), _locationLatitude, _locationLongitude, _locationName.Trim(), _locationAddress.Trim());
        var (result, error) = await Api.UpdateTenantSettingsAsync(request);

        _saving = false;

        if (result is null)
        {
            _saveError = error;
            return;
        }

        _settings = result;
    }

    private async Task UploadImage(InputFileChangeEventArgs e, string slot)
    {
        _uploadError = null;

        if (e.File.Size > MaxUploadSizeBytes)
        {
            _uploadError = "La imagen no puede superar los 5 MB.";
            return;
        }

        await using var stream = e.File.OpenReadStream(MaxUploadSizeBytes);
        var (result, error) = await Api.UploadTenantImageAsync(slot, stream, e.File.Name, e.File.ContentType);

        if (result is null)
        {
            _uploadError = error;
            return;
        }

        _settings = result;
    }

    // Las URLs de fotos que devuelve el Api son relativas (ej. "/uploads/xxx.jpg")
    // — el browser las pide directo al Api, no a través de Blazor Server, así
    // que hay que anteponerle la base URL. Si en algún momento ya vienen
    // absolutas (ej. un tenant de prueba con imagen externa), se dejan igual.
    private string ResolveImageUrl(string url)
    {
        if (url.StartsWith("http://") || url.StartsWith("https://")) return url;

        var apiBaseUrl = Configuration["Api:BaseUrl"]?.TrimEnd('/') ?? "";
        return $"{apiBaseUrl}{url}";
    }
}
