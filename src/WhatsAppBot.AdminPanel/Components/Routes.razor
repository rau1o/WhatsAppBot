@implements IDisposable
@inject AuthState AuthState
@inject SessionPersistence SessionPersistence

<CascadingAuthenticationState>
    <Router AppAssembly="@typeof(Program).Assembly">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
                <NotAuthorized>
                    <RedirectToLogin />
                </NotAuthorized>
            </AuthorizeRouteView>
        </Found>
        <NotFound>
            <LayoutView Layout="@typeof(MainLayout)">
                <p class="muted">Esa página no existe.</p>
            </LayoutView>
        </NotFound>
    </Router>
</CascadingAuthenticationState>

@code {
    // El intento de RESTAURAR la sesión vive en Login.razor (que es a
    // donde el framework ya manda a cualquiera sin sesión) — acá solo
    // sincronizamos el storage cada vez que la sesión cambia (login,
    // logout, o el refresh token rotando en cada uso), sin importar
    // desde dónde haya cambiado.
    protected override void OnInitialized()
    {
        AuthState.OnChange += PersistCurrentSession;
    }

    private async void PersistCurrentSession()
    {
        try
        {
            if (AuthState.IsAuthenticated && AuthState.RefreshToken is not null)
                await SessionPersistence.SaveRefreshTokenAsync(AuthState.RefreshToken);
            else
                await SessionPersistence.ClearAsync();
        }
        catch (Exception)
        {
            // Un event handler síncrono no puede propagar esto de forma
            // útil — a lo sumo, el próximo F5 no encuentra sesión guardada
            // y pide loguearse de nuevo, que es una falla segura.
        }
    }

    public void Dispose()
    {
        AuthState.OnChange -= PersistCurrentSession;
    }
}
